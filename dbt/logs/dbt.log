  create  table "warehouse"."mart_mart"."fact_payments__dbt_tmp"
  
  
    as
  
  (
    SELECT p.payment_id,
    p.order_id,
    o.customer_id,
    TRIM(c.full_name) AS customer_name,
    p.payment_method,
    p.amount,
    p.payment_date,
    DATE(p.payment_date) AS payment_day
FROM master.public.ods_payments p
    LEFT JOIN master.public.ods_orders o ON p.order_id = o.order_id
    LEFT JOIN master.public.ods_customers c ON o.customer_id = c.customer_id
WHERE c.is_deleted = FALSE
  );
  
